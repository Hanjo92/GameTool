{
  "name": "gametool",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/local-service/main.ts",
    "mcp": "node scripts/mcp.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "fonts:cache": "node scripts/cache-fonts.mjs",
    "reference:visual": "tsx scripts/reference-visual.ts",
    "workspace:smoke": "tsx scripts/workspace-smoke.ts",
    "particles:visual": "tsx scripts/reference-visual.ts --particles-only",
    "skill:smoke": "node scripts/skill-smoke.mjs",
    "security:repo": "node scripts/repository-check.mjs",
    "studio:workflows": "tsx scripts/studio-workflow-smoke.ts",
    "studio:mcp": "tsx scripts/studio-mcp-smoke.ts",
    "studio:runtime": "tsx scripts/studio-runtime-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "fonteditor-core": "2.6.3",
    "phaser": "3.90.0",
    "playwright": "1.58.2",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "0.183.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
